DATABASE_URL="file:./dev.db"
SESSION_SECRET="ganti-dengan-rentetan-rawak-sekurang-kurangnya-32-aksara"
UPLOAD_DIR="./data/uploads"

# Untuk deploy ke Vercel + Turso (percuma selama-lamanya, pilihan) -
# tetapkan dua ini untuk guna Turso sebagai ganti SQLite tempatan
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Untuk deploy ke Vercel + Vercel Blob (percuma, pilihan) - auto-suntik
# oleh Vercel bila Blob storage disambungkan ke projek
BLOB_READ_WRITE_TOKEN=""

# Untuk fungsi Ringkasan AI (pilihan) - dapatkan API key percuma di
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# URL awam aplikasi (untuk pautan dalam emel notifikasi)
APP_URL="http://localhost:3000"

# Untuk notifikasi emel bila tindakan di-assign (pilihan) - guna EmailJS
# (percuma, hantar melalui akaun Gmail sendiri, tiada domain diperlukan).
# Dapatkan nilai di bawah dari emailjs.com selepas sambungkan akaun Gmail
# dan cipta template - lihat panduan penuh dalam README.
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
